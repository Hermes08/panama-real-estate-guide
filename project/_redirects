# Netlify _redirects — multilingual fallbacks
#
# Per-language INDEX pages (/es/articles/, /es/news/, /es/videos/, /pt/..., /de/...)
# ARE now built statically — each renders the listing in the user's language by
# reading window.PREG_LANG and looking up titles via articleMeta + chrome-i18n.
# So no redirect needed for those.
#
# /es/projects/<slug> and /es/news/<slug>.html and /es/videos/<id>.html are NOT
# yet built per-language — fall back to EN canonical to prevent 404.
#
# Status 301 = permanent redirect.

/es/projects/*  /projects/:splat  301
/pt/projects/*  /projects/:splat  301
/de/projects/*  /projects/:splat  301

/es/news/*  /news/:splat  301
/pt/news/*  /news/:splat  301
/de/news/*  /news/:splat  301

/es/videos/*  /videos/:splat  301
/pt/videos/*  /videos/:splat  301
/de/videos/*  /videos/:splat  301

# Legacy Spanish-slug privacy/terms (DetailFooter used to point there)
/privacidad  /privacy.html  301
/terminos    /terms.html    301
